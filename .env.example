# Copy this file to .env.local for local development with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
#   Project -> Settings -> Environment Variables
# Never commit real values for these to the repository.

# REQUIRED — the only variable you actually need to set.
# Your Resend API key (https://resend.com -> API Keys). Starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — already defaults to mahendran.cbe90@gmail.com in code.
# Only set this if you want enquiries delivered somewhere else.
# CONTACT_TO_EMAIL=mahendran.cbe90@gmail.com

# OPTIONAL — already defaults to Resend's shared test address, which
# works immediately with no domain setup. Once you verify your own
# domain in Resend (Domains -> Add Domain), set this to an address on
# it for a fully branded "from" address instead.
# CONTACT_FROM_EMAIL=onboarding@resend.dev
